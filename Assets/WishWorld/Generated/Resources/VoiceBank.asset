  - text: AR Worlds. Bring them to you.
    clip: {fileID: 8300000, guid: 7f23a41efb0dd6200acd5b026b598fef, type: 3}
  - text: Wish. Say what you wish for.
    clip: {fileID: 8300000, guid: 7a2decda7199b02159bddbf4812877a7, type: 3}
  - text: Frost Slice. Slice the flying fruit.
    clip: {fileID: 8300000, guid: dc13b4c5cf0836160a349103b7d1906f, type: 3}
  - text: Snow Circuit. Race a snowy track.
    clip: {fileID: 8300000, guid: 64c7565087c53612798974e653cf0d49, type: 3}
  - text: Three.
    clip: {fileID: 8300000, guid: d4b3a601517c11927962b16023bd1e8d, type: 3}
  - text: Two.
    clip: {fileID: 8300000, guid: a67174899d76eea53a2c72593e76b501, type: 3}
  - text: One.
    clip: {fileID: 8300000, guid: cb967632d8a883d2cb97e6b470cc165a, type: 3}
  - text: Go!
    clip: {fileID: 8300000, guid: 70b8ff4960266a4e6988e89f42d09969, type: 3}
  - text: Games. Slice fruit, or race a car.
    clip: {fileID: 8300000, guid: 986af0f1e8b5da84db5660135cdec05b, type: 3}
  - text: Worlds. Where would you like to go?
    clip: {fileID: 8300000, guid: 544fc13e4d70169fd92a2bc4dfab38ff, type: 3}
  - text: Frost Slice. Swing the controllers to slice the fruit. Leave the ice blocks
      alone!
    clip: {fileID: 8300000, guid: 57741dbec6442c8b1b61f7bfeb6f52e2, type: 3}
  - text: Snow Circuit. Hold both controllers like a steering wheel. Right trigger
      to go, left trigger to brake.
    clip: {fileID: 8300000, guid: 64c3df57fe1190f7fbceabd7375f3402, type: 3}
  - text: Slice the fruit! Leave the ice alone.
    clip: {fileID: 8300000, guid: be1034a5870d0de44be5538283f0c5b1, type: 3}
  - text: Slice the fruit!
    clip: {fileID: 8300000, guid: 8782642162b6b4a5d8dfbf1588ab4300, type: 3}
  - text: A new best score! Amazing slicing.
    clip: {fileID: 8300000, guid: b0e95df8c2987063f8780c3e62037005, type: 3}
  - text: Nice slicing! Want another go?
    clip: {fileID: 8300000, guid: 567d7e9f442639ae4a8630b368bd975c, type: 3}
  - text: What a swing!
    clip: {fileID: 8300000, guid: 40051717a1054a6288fc24d3aff45de2, type: 3}
  - text: A new best lap! Great driving.
    clip: {fileID: 8300000, guid: 86dc1c8a253d9d0159250298c1e338e6, type: 3}
  - text: Great driving! Want another race?
    clip: {fileID: 8300000, guid: f5cb254ba108fd317af720819331b090, type: 3}
  - text: Last lap!
    clip: {fileID: 8300000, guid: 5fc58a3b42333b6d29f477a205c5c6d0, type: 3}
  - text: Welcome to WishWorld! Pick a card to begin.
    clip: {fileID: 8300000, guid: 830a57259792a720882eee01a4542a62, type: 3}
  - text: Okay, I put it back.
    clip: {fileID: 8300000, guid: 5903d74bfbb2d5e7aae018175be86de0, type: 3}
  - text: There is nothing to undo.
    clip: {fileID: 8300000, guid: 395cbea034cbcc6fea61f23a6cfd7add, type: 3}
  - text: All clear.
    clip: {fileID: 8300000, guid: af3a7410ea8439ed9b5050bf5b293936, type: 3}
  - text: Here it is, in your room.
    clip: {fileID: 8300000, guid: 1eee8e02c900f07a0a5ec92ca26dfb66, type: 3}
  - text: Off we go!
    clip: {fileID: 8300000, guid: 9af64a3c518f36cc682c106bd2ddc305, type: 3}
  - text: A few less.
    clip: {fileID: 8300000, guid: 821bfb0573978b1ab9134153f508e45c, type: 3}
  - text: More and more!
    clip: {fileID: 8300000, guid: 9104def2f8f343ea4ab13c269fa1c068, type: 3}
  - text: So small!
    clip: {fileID: 8300000, guid: 87b3b47fc34d75f4fbc9fd86b75c18ef, type: 3}
  - text: So big!
    clip: {fileID: 8300000, guid: 50b0ed5d8f59b04e786d919e30488e2d, type: 3}
  - text: Let it snow!
    clip: {fileID: 8300000, guid: 4254238b94a6a02d7a23aad93ee3cd50, type: 3}
  - text: Goodnight, world.
    clip: {fileID: 8300000, guid: 4a92500b1ecc5736bb52adbd85e59bd6, type: 3}
  - text: Hello, sunshine!
    clip: {fileID: 8300000, guid: a8293fba1026249728db3025081f26f8, type: 3}
  - text: I can't make that yet. Want a shark instead?
    clip: {fileID: 8300000, guid: b1486cf4b5fc5b68e9472d848808708e, type: 3}
  - text: Perfect score! You are a real explorer.
    clip: {fileID: 8300000, guid: 494ac08f8a38e4b37a836d6b7b941f84, type: 3}
  - text: Nice exploring! Want to look around some more?
    clip: {fileID: 8300000, guid: 5df38ce0482d865b6817f5b5d9d551e4, type: 3}
  - text: This is your room. Say or pick what should visit!
    clip: {fileID: 8300000, guid: 2421864faead7b93a97da43353406a49, type: 3}
  - text: What do you wish for? Say it, or pick from the menu.
    clip: {fileID: 8300000, guid: e45b7ff5620556b1eb0b898c26591673, type: 3}
  - text: You found them all! Press Finish for a quiz.
    clip: {fileID: 8300000, guid: 71aec468604419d0390ebbac68052064, type: 3}
