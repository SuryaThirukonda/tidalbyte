%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ccccf7f966472989681792ff4a15b051, type: 3}
  m_Name: VoiceBank
  m_EditorClassIdentifier: Assembly-CSharp::WishWorld.VoiceBank
  voiceName: cgSgspJ2msm6clMCkdW9
  entries:
  - text: Welcome to the aquarium! Touch a creature to learn about it.
    clip: {fileID: 8300000, guid: 4cce0b3c5ed930e2ca93ab7fe8c6df85, type: 3}
  - text: Welcome to the savanna. Look how tall the giraffe is!
    clip: {fileID: 8300000, guid: 2951a655796941f7e8730a3d3d61e9a8, type: 3}
  - text: Welcome to space. Everything here is floating!
    clip: {fileID: 8300000, guid: 010307e31f7fa9eba85e8b278057fe21, type: 3}
  - text: Shh. The dinosaurs are walking by.
    clip: {fileID: 8300000, guid: e56b6901ab8ce17d2ab219dd7bd6afb2, type: 3}
  - text: Brr! Welcome to the ice, under the northern lights.
    clip: {fileID: 8300000, guid: 819e1a5e0cbd8a550b1a0a034a3043de, type: 3}
  - text: Listen. The rainforest is full of life.
    clip: {fileID: 8300000, guid: 26ee273506735e4c8818c6db6b315770, type: 3}
  - text: Welcome to the farm. Say hello to the animals!
    clip: {fileID: 8300000, guid: e3c2ba8fcb09b1f6d8e6301ca9ae7e19, type: 3}
  - text: We are above the clouds. Look who is flying by!
    clip: {fileID: 8300000, guid: 2f17b436906e90965b798d705e0fc258, type: 3}
  - text: Welcome to the Wish World!
    clip: {fileID: 8300000, guid: 675add01573705619ba1d77d732ea7ac, type: 3}
  - text: Clownfish live among the stinging arms of sea anemones, which do not hurt
      them.
    clip: {fileID: 8300000, guid: 71cf02d8a2a39138890863b79516d29b, type: 3}
  - text: Which fish makes its home in a sea anemone?
    clip: {fileID: 8300000, guid: 8fdea990b936c6d5a8f73fdc6b5909b6, type: 3}
  - text: Here comes the clownfish!
    clip: {fileID: 8300000, guid: e97f412b3652d7cf0b04dfc77b47470d, type: 3}
  - text: Sea turtles swim back to the beach where they hatched to lay their own
      eggs.
    clip: {fileID: 8300000, guid: 58fb52c35cb119f478441a00768fe510, type: 3}
  - text: Which animal returns to the beach where it hatched to lay its eggs?
    clip: {fileID: 8300000, guid: 31691ba5923ac4cd38eca9b123ac9ee8, type: 3}
  - text: Here comes the sea turtle!
    clip: {fileID: 8300000, guid: afc48767cbc67ec60a66cc879dbcad5c, type: 3}
  - text: A shark has no bones. Its skeleton is made of cartilage, the bendy stuff
      in your ears.
    clip: {fileID: 8300000, guid: a45f6f58694019c21b0f488250c7102e, type: 3}
  - text: Which animal has a skeleton of cartilage and no bones?
    clip: {fileID: 8300000, guid: 37d26684db11f5d37a0f44f92b1f07b6, type: 3}
  - text: Here comes the shark!
    clip: {fileID: 8300000, guid: a5f2e2704899d4faf81df9374fe1e2e8, type: 3}
  - text: Jellyfish have no brain, no heart and no bones.
    clip: {fileID: 8300000, guid: 3061ff7ae87c9c02cb0076536b0e5b16, type: 3}
  - text: Which sea animal has no brain and no heart?
    clip: {fileID: 8300000, guid: 362a8d9cbff46c2889dd38b7de58669e, type: 3}
  - text: Here comes the jellyfish!
    clip: {fileID: 8300000, guid: a092885297d72d07d8fa32a293dab93e, type: 3}
  - text: Rays swim by flapping their wide fins like wings.
    clip: {fileID: 8300000, guid: be611cc955a4b0d3ea2d322ec9b435d3, type: 3}
  - text: Which sea animal swims by flapping its fins like wings?
    clip: {fileID: 8300000, guid: a413fbb8978247facad183830d7b76ff, type: 3}
  - text: Here comes the ray!
    clip: {fileID: 8300000, guid: bf36808b201bdd6a5861e09856804323, type: 3}
  - text: An elephant's trunk has no bones in it. It is all muscle.
    clip: {fileID: 8300000, guid: 255a07fb0dd490954a676f26270a783c, type: 3}
  - text: Which animal has a long nose with no bones in it?
    clip: {fileID: 8300000, guid: a1797f08c821d2728aceba1eb95a03e1, type: 3}
  - text: Here comes the elephant!
    clip: {fileID: 8300000, guid: 33ed7370ec37254159dfac12b63feac6, type: 3}
  - text: A giraffe's long neck has seven bones, the same number as your neck.
    clip: {fileID: 8300000, guid: 282683b711e6147dcbb9e547517af468, type: 3}
  - text: Which animal's long neck has seven bones, just like yours?
    clip: {fileID: 8300000, guid: 44eec80399601a386a368095761e517f, type: 3}
  - text: Here comes the giraffe!
    clip: {fileID: 8300000, guid: 99d7f6c144721be27aa06e8092e8ccbb, type: 3}
  - text: Every zebra has its own stripe pattern. No two are the same.
    clip: {fileID: 8300000, guid: d6320cf381fa745ed80c2abbce63b894, type: 3}
  - text: Which animal has stripes that are different on every one?
    clip: {fileID: 8300000, guid: b1811773b5e0f22a5b068bd9fa24ec08, type: 3}
  - text: Here comes the zebra!
    clip: {fileID: 8300000, guid: deadaad5375649a78b0e2e2c86a80250, type: 3}
  - text: A lion's roar can be heard from several kilometres away.
    clip: {fileID: 8300000, guid: 600e9b019891b50f1b6b995c1ee53538, type: 3}
  - text: Whose roar can be heard from kilometres away?
    clip: {fileID: 8300000, guid: af990c8b1fd4b329db7492ac51b7c8f1, type: 3}
  - text: Here comes the lion!
    clip: {fileID: 8300000, guid: 0eeb34721174bfa26bf2789698708cf4, type: 3}
  - text: Flamingos are pink because of the food they eat.
    clip: {fileID: 8300000, guid: b4f65c7d74761bd818f809549903e9ce, type: 3}
  - text: Which bird turns pink because of its food?
    clip: {fileID: 8300000, guid: ce60301262f0c9afa9a91b2ad764a06f, type: 3}
  - text: Here comes the flamingo!
    clip: {fileID: 8300000, guid: c7fa82cdab8340b7f86bf8341d5cdec9, type: 3}
  - text: Saturn's rings are made mostly of pieces of ice.
    clip: {fileID: 8300000, guid: 49ac874a0a462e06991e370d6b2fb6e5, type: 3}
  - text: Which planet has rings made mostly of ice?
    clip: {fileID: 8300000, guid: 2f4de38573162d1e89541fc2ea2a98ce, type: 3}
  - text: Here comes the saturn!
    clip: {fileID: 8300000, guid: 1af76673fbe287b14996008c7969906a, type: 3}
  - text: More than two thirds of the Earth is covered by ocean.
    clip: {fileID: 8300000, guid: 372f3a8a501ed80e1a5c43fb98ee8a45, type: 3}
  - text: Which planet is mostly covered by ocean?
    clip: {fileID: 8300000, guid: 636bb614e23d24ae6b2b528766b1d261, type: 3}
  - text: Here comes the earth!
    clip: {fileID: 8300000, guid: 8761e2ca3af138d7ebea941b6aa19ef6, type: 3}
  - text: A day on Venus is longer than its year.
    clip: {fileID: 8300000, guid: 3c35f07d2043bc8f2b8f6386c5acdf13, type: 3}
  - text: On which planet is a day longer than a year?
    clip: {fileID: 8300000, guid: e175213210a1102299a9e9ca8759bd90, type: 3}
  - text: Here comes the venus!
    clip: {fileID: 8300000, guid: 63a070fcfc9c8f5d0a8f7bbf5807a2f5, type: 3}
  - text: Astronauts in orbit float because they are falling around the Earth all
      the time.
    clip: {fileID: 8300000, guid: be1c2bfb47e63e8e69b182cd6ac7acc7, type: 3}
  - text: Who floats while circling the Earth?
    clip: {fileID: 8300000, guid: 9241f88c92d021614874b2d9329ff2ae, type: 3}
  - text: Here comes the astronaut!
    clip: {fileID: 8300000, guid: 3b062e209e3a21377a3a4735467ead85, type: 3}
  - text: To stay in orbit, a rocket has to reach about 28,000 kilometres an hour.
    clip: {fileID: 8300000, guid: b8e71d5dcfbaa925fa0d8c4267a46ef3, type: 3}
  - text: What must reach about 28,000 kilometres an hour to stay in orbit?
    clip: {fileID: 8300000, guid: ccb4b63b22bbc5ff8b8fef3e9e144af9, type: 3}
  - text: Here comes the rocket!
    clip: {fileID: 8300000, guid: 934462689aa96dd25b6f7c4aaeec6562, type: 3}
  - text: Satellites circle the Earth. Some help phones and maps know where you are.
    clip: {fileID: 8300000, guid: fc72a9390fded7bb58e06d06711c104b, type: 3}
  - text: What circles the Earth and helps maps know where you are?
    clip: {fileID: 8300000, guid: f87acc87faf616b21905477d5eac7d3b, type: 3}
  - text: Here comes the satellite!
    clip: {fileID: 8300000, guid: 72e4d9163accfd6efb134f48dee6c498, type: 3}
  - text: A comet is a ball of ice and dust. Its tail always points away from the
      Sun.
    clip: {fileID: 8300000, guid: 1e9125953a159c1909f798316179758e, type: 3}
  - text: What is a ball of ice and dust with a long tail?
    clip: {fileID: 8300000, guid: 7ecb60a89ea6398d5a72045934ed6cdc, type: 3}
  - text: Here comes the comet!
    clip: {fileID: 8300000, guid: 54dd2b8bc000f9e11acf32422ca16019, type: 3}
  - text: T. rex lived closer in time to you than to Stegosaurus.
    clip: {fileID: 8300000, guid: e240645785605758f9579d5d264d22ad, type: 3}
  - text: Which dinosaur lived closer in time to you than to Stegosaurus?
    clip: {fileID: 8300000, guid: 20635e9a2fa77d4fcaa615e2b6ece64c, type: 3}
  - text: Here comes the t. rex!
    clip: {fileID: 8300000, guid: ab2c1df6e616e3d54ac6f15c1d82a55c, type: 3}
  - text: The name Triceratops means three-horned face.
    clip: {fileID: 8300000, guid: 021c9c5c7c2ba80d6a692e641c380453, type: 3}
  - text: Which dinosaur's name means three-horned face?
    clip: {fileID: 8300000, guid: 2c5abb44d4744fb0598455ea2a6dafc1, type: 3}
  - text: Here comes the triceratops!
    clip: {fileID: 8300000, guid: 1020fa8f633ccbbb6987f77c90b8fb3d, type: 3}
  - text: Stegosaurus had two rows of bony plates along its back.
    clip: {fileID: 8300000, guid: a70d480b0b9e1b969ae45fc72a4c2fae, type: 3}
  - text: Which dinosaur had bony plates along its back?
    clip: {fileID: 8300000, guid: cbe54398d75c98a14a83ac1c4b690722, type: 3}
  - text: Here comes the stegosaurus!
    clip: {fileID: 8300000, guid: c31ee4772b68031bebb0e7a4ec94bc11, type: 3}
  - text: Pterosaurs were flying reptiles. They were not dinosaurs.
    clip: {fileID: 8300000, guid: 09e57838ccd2e8624859c5666a6e6fce, type: 3}
  - text: Which flying reptile was not really a dinosaur?
    clip: {fileID: 8300000, guid: 306ea982a5c6aa7cf8ac85cc6ea9b9d9, type: 3}
  - text: Here comes the pterosaur!
    clip: {fileID: 8300000, guid: 892a892700a4f11398e36f5a2b8d93e5, type: 3}
  - text: Penguins live in the south and polar bears in the north, so they never
      meet in the wild.
    clip: {fileID: 8300000, guid: 59145e292b28f7b06bfa690905207200, type: 3}
  - text: Which bird lives in the south and never meets a polar bear?
    clip: {fileID: 8300000, guid: 45bcfd5d5757ff1dd8edaeaf574f4ce7, type: 3}
  - text: Here comes the penguin!
    clip: {fileID: 8300000, guid: 9380f37821495e464860b83592b974d6, type: 3}
  - text: Under its white fur, a polar bear's skin is black.
    clip: {fileID: 8300000, guid: 087dfc822e5f62413bef86fe692b96e0, type: 3}
  - text: Which animal has black skin under white fur?
    clip: {fileID: 8300000, guid: 595eb2207ab898a108a37df31d00605d, type: 3}
  - text: Here comes the polar bear!
    clip: {fileID: 8300000, guid: bffae677161f98fa5bee6820fd48aa21, type: 3}
  - text: Seals have a thick layer of fat called blubber that keeps them warm.
    clip: {fileID: 8300000, guid: 0da0b7e8db8510fa48ab99bf5d7e6f30, type: 3}
  - text: Which animal keeps warm with a layer of blubber?
    clip: {fileID: 8300000, guid: aa99f60d5828e747383f67b7c394e729, type: 3}
  - text: Here comes the seal!
    clip: {fileID: 8300000, guid: a464e865d5b970e029f25c1bf81694b4, type: 3}
  - text: The blue whale is the largest animal that has ever lived.
    clip: {fileID: 8300000, guid: fc3fa3ea0bde60e89b2d58bfe8fa806f, type: 3}
  - text: Which is the largest animal that has ever lived?
    clip: {fileID: 8300000, guid: 7944d5f85cbd624588a88e6880c3abcf, type: 3}
  - text: Here comes the blue whale!
    clip: {fileID: 8300000, guid: 9a05c5886b62eded796095855c58cbdb, type: 3}
  - text: Unlike most owls, snowy owls often hunt in the daytime.
    clip: {fileID: 8300000, guid: 433fc29431c17cfa79dfe595f90d036d, type: 3}
  - text: Which owl often hunts in the daytime?
    clip: {fileID: 8300000, guid: f45cbe093aff213b08bf708ae0540b54, type: 3}
  - text: Here comes the snowy owl!
    clip: {fileID: 8300000, guid: 0a55ea9af97e77acca0809694d62a94e, type: 3}
  - text: Parrots can copy sounds, even human words.
    clip: {fileID: 8300000, guid: 08e7b6f2ad324f01bb3381f5539f0de7, type: 3}
  - text: Which bird can copy human words?
    clip: {fileID: 8300000, guid: 68ed36c73d4497a93b5db2c404fd0803, type: 3}
  - text: Here comes the parrot!
    clip: {fileID: 8300000, guid: 2bc624f3adf3c7a499149f854d0606d6, type: 3}
  - text: Some monkeys, like spider monkeys, can hang from a branch by their tails.
    clip: {fileID: 8300000, guid: d8da5ae3068ee305bb2635d57398d239, type: 3}
  - text: Which animal can hang from a branch by its tail?
    clip: {fileID: 8300000, guid: 1171b3a0f7f006bb384797528c8399cd, type: 3}
  - text: Here comes the monkey!
    clip: {fileID: 8300000, guid: f22f763330655e977a92a16b491bfe46, type: 3}
  - text: Poison dart frogs wear bright colours to warn that they are poisonous.
    clip: {fileID: 8300000, guid: 355c0ddbe454fcb9dbe0b685dc6722ab, type: 3}
  - text: Which animal uses bright colours as a warning?
    clip: {fileID: 8300000, guid: 93c6445daf6e85a9692e84d997cb63f5, type: 3}
  - text: Here comes the tree frog!
    clip: {fileID: 8300000, guid: f8d3209e5e526822a8550963267ecf6a, type: 3}
  - text: Butterflies taste with their feet.
    clip: {fileID: 8300000, guid: cb62312feeda26a1b897886f920526db, type: 3}
  - text: Which insect tastes with its feet?
    clip: {fileID: 8300000, guid: a1444021e1d6317d39a7e6f6d2bef738, type: 3}
  - text: Here comes the butterfly!
    clip: {fileID: 8300000, guid: 6c55929db7e9bca0885c45d6db558e95, type: 3}
  - text: Sloths move so slowly that green algae grows in their fur.
    clip: {fileID: 8300000, guid: c071c48520076eb7ba681d3d5036f609, type: 3}
  - text: Which animal moves so slowly that algae grows in its fur?
    clip: {fileID: 8300000, guid: 395465e07d60037d9afd6020bc664730, type: 3}
  - text: Here comes the sloth!
    clip: {fileID: 8300000, guid: 6765c355051fb8200b0bdf08fd5b56bd, type: 3}
  - text: A cow's stomach has four parts.
    clip: {fileID: 8300000, guid: d475e555c530d36a6aa475a364e27551, type: 3}
  - text: Which farm animal has a stomach with four parts?
    clip: {fileID: 8300000, guid: 57420835048f87e019a8ff23448a73d1, type: 3}
  - text: Here comes the cow!
    clip: {fileID: 8300000, guid: 5f730adafc87ce4cda34fc1792f31e81, type: 3}
  - text: A sheep's wool never stops growing.
    clip: {fileID: 8300000, guid: 4f6a6a996febc3bf397d2493f86f5341, type: 3}
  - text: Which animal has wool that never stops growing?
    clip: {fileID: 8300000, guid: ce79b88a3858e2bbebc1c1ff005feb3f, type: 3}
  - text: Here comes the sheep!
    clip: {fileID: 8300000, guid: ff7af26d90d6d29d6811edc6c67e293c, type: 3}
  - text: Horses can sleep standing up.
    clip: {fileID: 8300000, guid: 8addec26715a296f8b5049cf62cf99db, type: 3}
  - text: Which animal can sleep standing up?
    clip: {fileID: 8300000, guid: 6a8f9a0de309dfd3590128cdd64bdd33, type: 3}
  - text: Here comes the horse!
    clip: {fileID: 8300000, guid: 12c9aba791b04b9749b5b8f410c117e1, type: 3}
  - text: Birds, including chickens, are living relatives of the dinosaurs.
    clip: {fileID: 8300000, guid: 8220678b68d6bef4294912a64ce2c225, type: 3}
  - text: Which farm bird is a living relative of the dinosaurs?
    clip: {fileID: 8300000, guid: 39471b9a21adf8ecf87d5c230a57d659, type: 3}
  - text: Here comes the chicken!
    clip: {fileID: 8300000, guid: 028de0d4e11b30bb7814c8855dad6438, type: 3}
  - text: Pigs roll in mud to cool down, because they can hardly sweat.
    clip: {fileID: 8300000, guid: c7cd00f920e4a62bd94a50cabf4f8406, type: 3}
  - text: Which animal rolls in mud to cool down?
    clip: {fileID: 8300000, guid: acd0c811f5c1cb42d80c52e9ebf6be5d, type: 3}
  - text: Here comes the pig!
    clip: {fileID: 8300000, guid: f7ac7250983ecbf5fbb1fb164599e839, type: 3}
  - text: Hot air is lighter than cool air. That is what lifts a hot-air balloon.
    clip: {fileID: 8300000, guid: 7785aee5247f05d47a1ced9f90ee858b, type: 3}
  - text: What rises because hot air is lighter than cool air?
    clip: {fileID: 8300000, guid: 1104bb5b68d95fb8d9cacaddb7fae723, type: 3}
  - text: Here comes the hot-air balloon!
    clip: {fileID: 8300000, guid: cf6e2dcf150c7b3baa20c2323845dcc4, type: 3}
  - text: Many birds have hollow bones, which helps them fly.
    clip: {fileID: 8300000, guid: 27e9a57b1cd95b7079942db18fffce5e, type: 3}
  - text: Which animals have hollow bones that help them fly?
    clip: {fileID: 8300000, guid: 327cd5c698ab10139a4f41c5939792aa, type: 3}
  - text: Here comes the bird!
    clip: {fileID: 8300000, guid: d9dc33abaf542211dae38f7f14de1ce5, type: 3}
  - text: Kites were invented in China more than two thousand years ago.
    clip: {fileID: 8300000, guid: 32cbcfac14bd29c9e9337275af1c97c4, type: 3}
  - text: What flying toy was invented in China over two thousand years ago?
    clip: {fileID: 8300000, guid: c29ebde30093632e18bd3326d1fafb99, type: 3}
  - text: Here comes the kite!
    clip: {fileID: 8300000, guid: 8848b0eb405029b36b5f1996ecd2ef85, type: 3}
  - text: A plane's wings are shaped so that the air rushing past pushes them up.
    clip: {fileID: 8300000, guid: 786c3e180c607e06780fbf06b0676c9c, type: 3}
  - text: What has wings shaped so that rushing air pushes them up?
    clip: {fileID: 8300000, guid: d57253c530aea847d94fcac7f7901156, type: 3}
  - text: Here comes the plane!
    clip: {fileID: 8300000, guid: eb0b928679ddedadba7b21642019fe21, type: 3}
  - text: Ooh, red!
    clip: {fileID: 8300000, guid: 08e6692abb1a1487eaf22c3bfaaa5995, type: 3}
  - text: Ooh, blue!
    clip: {fileID: 8300000, guid: 2d6ef742226c4ea8693e2a4b3394aa0a, type: 3}
  - text: Ooh, purple!
    clip: {fileID: 8300000, guid: 75e3f33a40bb32be2bb11bb620199971, type: 3}
  - text: Ooh, gold!
    clip: {fileID: 8300000, guid: f0fccb0af4082ab2e81cfa1350009e96, type: 3}
  - text: Ooh, rainbow!
    clip: {fileID: 8300000, guid: ca1c51863e7d31b37b6932c563fe9554, type: 3}
  - text: Lap 2!
    clip: {fileID: 8300000, guid: c682e770d97b3b8c99fb157d6464343d, type: 3}
  - text: Lap 3!
    clip: {fileID: 8300000, guid: 00ea34226b165bd648e05c3da9572484, type: 3}
  - text: Lap 4!
    clip: {fileID: 8300000, guid: 1f04d855d4e3ce0fe85f596c64a69e27, type: 3}
  - text: Lap 5!
    clip: {fileID: 8300000, guid: be9d1037e40754976987a5e9b7de5b7f, type: 3}
  - text: You finished first!
    clip: {fileID: 8300000, guid: 9826eb2403867103fa03a669e5c67573, type: 3}
  - text: You finished second!
    clip: {fileID: 8300000, guid: 70c27e6f64d41a2a1bbd5d27545a668c, type: 3}
  - text: You finished third!
    clip: {fileID: 8300000, guid: d15fc61064bf362fd81761257673b06b, type: 3}
  - text: You finished fourth!
    clip: {fileID: 8300000, guid: 2b72239f8cc78c910a01a689ab0c2afb, type: 3}
  - text: You finished fifth!
    clip: {fileID: 8300000, guid: 50ebf23ecaee52c648331257f474ee66, type: 3}
  - text: Yes! Clownfish.
    clip: {fileID: 8300000, guid: 775c286bd2c4b1568abe6bae51707cd0, type: 3}
  - text: It was the Clownfish.
    clip: {fileID: 8300000, guid: 6c215adf8aee917fea8e8e133b22bcc4, type: 3}
  - text: Clownfish
    clip: {fileID: 8300000, guid: ca2ad4c9a48b8d6528d092a9b3e7be41, type: 3}
  - text: Yes! Sea Turtle.
